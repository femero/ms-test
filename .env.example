# Copy to .env and fill in. The real .env is gitignored and must never be committed.
# Every variable below is referenced as ${NAME} with NO default value on purpose:
# if one is missing the application must fail at startup, not degrade silently
# (constitution IV).

# --- Database: PostgreSQL on Supabase -------------------------------------
# DB_URL must point to the direct connection or to the SESSION-mode pooler.
# The transaction-mode pooler is NOT compatible with Hibernate prepared statements.
# jdbc:postgresql://<host>:<port>/<database>?sslmode=require  (host=db.<project-ref>.supabase.co, port=5432, database=postgres)
DB_URL=
DB_USERNAME=
DB_PASSWORD=conciliacion

# https://github.com/redis-windows/redis-windows/releases#release-8.10.1
# Redis-8.10.1-Windows-x64-msys2.zip
# redis-server.exe
# --- Redis: local instance, fast idempotency pre-filter only ---------------
REDIS_HOSTS=redis://localhost:6379

# --- Kafka: Confluent Cloud ------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_API_KEY=
KAFKA_API_SECRET=

# --- Schema Registry: Confluent Cloud --------------------------------------
# These credentials are DIFFERENT from the cluster ones. Confluent Cloud issues
# two independent API key/secret pairs; reusing the broker pair returns 401.
SCHEMA_REGISTRY_URL=
SCHEMA_REGISTRY_API_KEY=
SCHEMA_REGISTRY_API_SECRET=

# --- Topic names -----------------------------------------------------------
# Not secrets, but they follow the same no-default rule: a topic name falling
# back to a default would make the service start reading or writing in the
# wrong place, and the failure would show up as silence instead of an error.
# The topics already exist; the team owns their names.
KAFKA_TOPIC_PAYMENTS_IN=
KAFKA_TOPIC_PAYMENTS_DLQ=
KAFKA_TOPIC_CORE_TRANSACTIONS_IN=
KAFKA_TOPIC_CORE_TRANSACTIONS_DLQ=
KAFKA_TOPIC_RESULTS_OUT=
KAFKA_TOPIC_DISCREPANCIES_OUT=